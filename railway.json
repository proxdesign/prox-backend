{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "pip install -r requirements.txt"
  },
  "deploy": {
    "startCommand": "cd prox_autonomous_discovery && uvicorn api.main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "on-failure",
    "restartPolicyMaxRetries": 10
  },
  "environments": {
    "production": {
      "variables": {
        "PROX_ENV": "production",
        "LOG_LEVEL": "INFO",
        "COLLECTION_FREQUENCY_HOURS": "6"
      }
    },
    "staging": {
      "variables": {
        "PROX_ENV": "staging",
        "LOG_LEVEL": "DEBUG",
        "COLLECTION_FREQUENCY_HOURS": "12"
      }
    }
  },
  "cron": {
    "datacollection": {
      "schedule": "0 */6 * * *",
      "command": "cd prox_autonomous_discovery && PYTHONPATH=/app/prox_autonomous_discovery python3 scripts/run_collection.py"
    },
    "trendscoring": {
      "schedule": "30 */6 * * *",
      "command": "cd prox_autonomous_discovery && PYTHONPATH=/app/prox_autonomous_discovery python3 scripts/run_trend_scoring.py"
    },
    "healthcheck": {
      "schedule": "*/30 * * * *",
      "command": "cd prox_autonomous_discovery && PYTHONPATH=/app/prox_autonomous_discovery python3 scripts/health_monitor.py --export json"
    }
  }
}