# Ignore everything except backend and active frontend
/*
!/prox_autonomous_discovery/
!/prox-frontend-v2/
!.gitignore
!README.md
!Procfile
!CLAUDE.md
!prox-setup.sh
!vercel.json

# Backend ignores
prox_autonomous_discovery/.env*
prox_autonomous_discovery/__pycache__/
prox_autonomous_discovery/**/*.pyc
prox_autonomous_discovery/**/*.pyo
prox_autonomous_discovery/**/*.pyd
prox_autonomous_discovery/**/__pycache__/
prox_autonomous_discovery/.DS_Store
prox_autonomous_discovery/venv/
prox_autonomous_discovery/logs/

# Frontend ignores
prox-frontend-v2/.env*
prox-frontend-v2/node_modules/
prox-frontend-v2/.next/
prox-frontend-v2/out/
prox-frontend-v2/.DS_Store

# Ignore archives and deprecated
00_archive/
prox-frontend/
design-agent/
