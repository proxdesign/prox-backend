{
  "name": "prox-frontend-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate-images": "node scripts/generate-solution-images.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:chat": "vitest run tests/chat-api.test.ts",
    "test:db": "vitest run tests/postgres-validation.test.ts",
    "test:ui": "vitest --ui",
    "test:save": "vitest run && cp tests/results/latest.json tests/results/$(date +%Y%m%d-%H%M%S).json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "warmup": "./scripts/warmup-categories.sh all production",
    "warmup:local": "./scripts/warmup-categories.sh all local",
    "warmup:quickfix": "./scripts/warmup-categories.sh quickfix production",
    "warmup:quickfix:local": "./scripts/warmup-categories.sh quickfix local"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.16.0",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.562.0",
    "next": "16.1.0",
    "pg": "^8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "replicate": "^1.4.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.23",
    "eslint": "^9",
    "eslint-config-next": "16.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
