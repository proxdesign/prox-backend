'use client';
import { useState } from 'react';
import { X } from 'lucide-react';
import Link from 'next/link';
import { trackSignUp, trackLogin, trackError } from '@/lib/analytics';

export interface User {
  id: number;
  email: string;
  name: string;
  created_at?: string;
  preferences?: any;
}

interface LoginModalProps {
  isOpen: boolean;
  onClose: () => void;
  onLogin: (user: User) => void;
}

export function LoginModal({ isOpen, onClose, onLogin }: LoginModalProps) {
  const [email, setEmail] = useState('');
  const [name, setName] = useState('');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');
  const [emailSent, setEmailSent] = useState(false);

  if (!isOpen) return null;

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoading(true);
    setError('');
    
    try {
      // Use the magic link backend endpoint
      const res = await fetch('http://localhost:8001/auth/request-magic-link', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, name: name || undefined })
      });
      
      const data = await res.json();
      
      if (!res.ok) {
        setError(data.message || 'Something went wrong');
        return;
      }
      
      // Show success state
      setEmailSent(true);
      trackLogin('magic_link');
      
    } catch (err) {
      setError('Failed to send magic link');
      trackError('magic_link_error', err instanceof Error ? err.message : 'Unknown error');
    } finally {
      setLoading(false);
    }
  };

  const handleClose = () => {
    setError('');
    setEmail('');
    setName('');
    setEmailSent(false);
    onClose();
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
      <div className="bg-white rounded-2xl p-6 w-full max-w-md relative">
        <button 
          onClick={handleClose}
          className="absolute top-4 right-4 text-gray-400 hover:text-gray-600 transition-colors"
        >
          <X size={24} />
        </button>
        
        <h2 className="text-xl font-semibold mb-2">
          {emailSent ? 'Check Your Email!' : 'Sign In to Prox'}
        </h2>
        <p className="text-gray-500 mb-6">
          {emailSent 
            ? 'We sent you a magic link! Click the link in your email to sign in.'
            : 'Enter your email and we\'ll send you a magic link to sign in. No password needed!'}
        </p>
        
        {!emailSent ? (
          <form onSubmit={handleSubmit} className="space-y-4">
            <input
              type="text"
              placeholder="Your name (optional)"
              value={name}
              onChange={(e) => setName(e.target.value)}
              className="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:border-[#5C7C5C] transition-colors"
            />
            
            <input
              type="email"
              placeholder="Email address"
              value={email}
              onChange={(e) => setEmail(e.target.value)}
              className="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:border-[#5C7C5C] transition-colors"
              required
            />
            
            {error && (
              <div className="p-3 bg-red-50 border border-red-200 rounded-lg">
                <p className="text-red-600 text-sm">{error}</p>
              </div>
            )}
            
            <button
              type="submit"
              disabled={loading}
              className="w-full py-3 bg-[#5C7C5C] text-white rounded-lg hover:bg-[#4a6a4a] transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
              {loading ? (
                <div className="flex items-center justify-center gap-2">
                  <div className="w-4 h-4 border-2 border-white/20 border-t-white rounded-full animate-spin" />
                  Sending magic link...
                </div>
              ) : (
                'Send Magic Link'
              )}
            </button>

            {/* Magic link explanation */}
            <div className="text-xs text-gray-400 text-center">
              ✨ Secure passwordless authentication
            </div>
          </form>
        ) : (
          <div className="text-center space-y-4">
            <div className="w-16 h-16 mx-auto bg-green-100 rounded-full flex items-center justify-center">
              <svg className="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <p className="text-gray-600">
              Magic link sent to <strong>{email}</strong>
            </p>
            <div className="space-y-2">
              <p className="text-sm text-gray-500">
                The link expires in 15 minutes for security.
              </p>
              <button
                onClick={() => setEmailSent(false)}
                className="text-[#5C7C5C] hover:underline text-sm font-medium"
              >
                Didn't receive it? Send another
              </button>
            </div>
          </div>
        )}
        
        {/* Terms note */}
        <p className="text-xs text-gray-400 text-center mt-4">
          By signing in, you agree to our{' '}
          <Link href="/terms" className="text-[#5C7C5C] hover:underline">
            Terms of Service
          </Link>
          {' '}and{' '}
          <Link href="/privacy-policy" className="text-[#5C7C5C] hover:underline">
            Privacy Policy
          </Link>
        </p>
      </div>
    </div>
  );
}